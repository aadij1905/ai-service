GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Which model generates suggestions: groq | gemini | mistral | cerebras | orchestrate
AI_PROVIDER=cerebras

# Orchestration (used when AI_PROVIDER=orchestrate):
# generators draft in parallel, judge merges/refines/ranks.
ORCH_GENERATORS=cerebras,gemini,groq
ORCH_JUDGE=cerebras

# Dev "Generate full code" button uses this model (independent of AI_PROVIDER)
CODE_PROVIDER=gemini

PORT=5001
ANALYTICS_SERVICE_URL=http://localhost:4000
