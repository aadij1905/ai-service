GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional, DEMO ONLY — extra Gemini keys from separate Google accounts/
# projects to rotate across free-tier quotas. Leave unset in production;
# see the comment in ai/geminiClient.js for why.
GEMINI_API_KEY_CODE_1=
GEMINI_API_KEY_CODE_2=
GEMINI_API_KEY_SUGGESTIONS_2=

# Which model generates suggestions: groq | gemini | mistral | cerebras | orchestrate
# DEMO: pinned to a single reliable provider instead of orchestrate — see
# the comment in .env for why. Flip freely between "groq" and "gemini"
# depending on which one currently has quota headroom.
AI_PROVIDER=gemini

# Orchestration (used when AI_PROVIDER=orchestrate):
# generators draft in parallel, judge merges/refines/ranks.
ORCH_GENERATORS=cerebras,gemini,groq
ORCH_JUDGE=cerebras

# Dev "Generate full code" button uses this model (independent of AI_PROVIDER)
CODE_PROVIDER=gemini

# Suggestion-quality guardrails (all default ON when crawler screenshots exist):
#   VISUAL_DETECTORS=off  — skip the per-screenshot visual-flaw pre-pass that
#                           merges dataQuality:"visual" flags into the prompt.
#   VISION_JUDGE=off      — skip the judge refinement (merge/filter/re-rank) on
#                           the single vision generation, matching orchestrate.
#   VISION_JUDGE_PROVIDER — who judges the vision path. Unset = follow the
#                           active AI_PROVIDER (an all-gemini setup judges with
#                           gemini), else ORCH_JUDGE. Set to pin explicitly.
#   GROUNDING_STRICT=true — drop items citing numbers absent from the data
#                           instead of just downgrading their confidence.
VISUAL_DETECTORS=on
VISION_JUDGE=on
GROUNDING_STRICT=false

PORT=5001
ANALYTICS_SERVICE_URL=http://localhost:4000

# shopify-pp (theme extractor) — used by /code/generate to pull the real
# theme files for a page before asking the model for a patch.
SHOPIFY_APP_URL=http://localhost:3000
